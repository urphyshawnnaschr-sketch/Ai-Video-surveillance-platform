<?xml version="1.0" encoding="UTF-8"?><configuration><!--Log Format should Use spring boot Default Format, Also can with Self more modify--><include resource="org/springframework/boot/logging/logback/defaults.xml"/><!--Fixed Meaning Log Store Put Bit set, Default Store Put In Project Start Phase for Path Directory--><property name="LOG_PATH" value="log"/><property name="FILE_LOG_PATTERN"
              value="%d{yyyy-MM-dd HH:mm:ss.SSS}-[%X{TRACE-ID}]-%-5level[%4line] - %logger{10} - %msg%n"/><property name="CONSOLE_LOG_PATTERN"
              value="%d{yyyy-MM-dd HH:mm:ss.SSS}-[%X{TRACE-ID}]-%-5level[%4line] - %logger{10} - %msg%n"/><!--******************************************************************************************--><!--****************************** Local Development only In Control Station Print Log ************************************--><!--******************************************************************************************--><springProfile name="dev"><appender name="STDOUT" class="ch.qos.logback.core.ConsoleAppender"><encoder><pattern>${CONSOLE_LOG_PATTERN}</pattern><!--<charset>utf-8</charset>--></encoder></appender><!--Default All Package with info--><root level="info"><appender-ref ref="STDOUT"/></root><logger name="com.hcxz.baseframework" level="debug"/><logger name="com.hithium" level="debug"/><!--each Service Package In Local Execute Hour Wait, Open debug Mode--><logger name="cn.stylefeng" level="debug" additivity="false"><appender-ref ref="STDOUT"/></logger></springProfile><!--**********************************************************************************************--><!--**** Put to Server up not Manage In What Environment all only In File Record Log, Control Station (catalina.out) Print logback Catch not to Log ****--><!--**********************************************************************************************--><springProfile name="!dev"><appender name="STDOUT" class="ch.qos.logback.core.ConsoleAppender"><encoder><pattern>${CONSOLE_LOG_PATTERN}</pattern><!--<charset>utf-8</charset>--></encoder></appender><!--Log Record Device, Date Roll Dynamic Record--><appender name="FILE_ERROR" class="ch.qos.logback.core.rolling.RollingFileAppender"><!--In Progress Record Log File Path and File Name--><file>${LOG_PATH}/log_error.log</file><!--Log Record Device Roll Dynamic Strategy, by Date, by big small Record--><rollingPolicy class="ch.qos.logback.core.rolling.TimeBasedRollingPolicy"><!--belong File Log File Path,%d{yyyy-MM-dd} Refer Fixed Date Format,%i Refer Fixed Index--><fileNamePattern>${LOG_PATH}/error/log-error-%d{yyyy-MM-dd}.%i.log.zip</fileNamePattern><!--Each produce produce One Log File, The Log File Save Period Limit for 30 day--><maxHistory>30</maxHistory><!--should Use Start Hour Clear Reason History Log File--><cleanHistoryOnStart>true</cleanHistoryOnStart><!--Divide by Log Record of outer, still Config Log File cannot exceed 2M, if super over 2M, Log File will with Index 0 Start, Life Name Log File, For example log-error-2013-12-21.0.log--><timeBasedFileNamingAndTriggeringPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedFNATP"><maxFileSize>100MB</maxFileSize></timeBasedFileNamingAndTriggeringPolicy></rollingPolicy><!--Track Add Mode Record Log--><append>true</append><!--Log File Format--><encoder class="ch.qos.logback.classic.encoder.PatternLayoutEncoder"><pattern>${FILE_LOG_PATTERN}</pattern><!--<charset>utf-8</charset>--></encoder><!--this Log File only Record error Level--><filter class="ch.qos.logback.classic.filter.LevelFilter"><level>error</level><onMatch>ACCEPT</onMatch><onMismatch>DENY</onMismatch></filter></appender><!--Log Record Device, Date Roll Dynamic Record--><appender name="FILE_INFO" class="ch.qos.logback.core.rolling.RollingFileAppender"><!--In Progress Record Log File Path and File Name--><file>${LOG_PATH}/log_total.log</file><!--Log Record Device Roll Dynamic Strategy, by Date, by big small Record--><rollingPolicy class="ch.qos.logback.core.rolling.TimeBasedRollingPolicy"><!--belong File Log File Path,%d{yyyy-MM-dd} Refer Fixed Date Format,%i Refer Fixed Index--><fileNamePattern>${LOG_PATH}/total/log-info-%d{yyyy-MM-dd}.%i.log.zip</fileNamePattern><!--Each produce produce One Log File, The Log File Save Period Limit for 30 day--><maxHistory>30</maxHistory><!--should Use Start Hour Clear Reason History Log File--><cleanHistoryOnStart>true</cleanHistoryOnStart><!--Divide by Log Record of outer, still Config Log File cannot exceed 2M, if super over 2M, Log File will with Index 0 Start, Life Name Log File, For example log-error-2013-12-21.0.log--><timeBasedFileNamingAndTriggeringPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedFNATP"><maxFileSize>100MB</maxFileSize></timeBasedFileNamingAndTriggeringPolicy></rollingPolicy><!--Track Add Mode Record Log--><append>true</append><!--Log File Format--><encoder class="ch.qos.logback.classic.encoder.PatternLayoutEncoder"><pattern>${FILE_LOG_PATTERN}</pattern><!--<charset>utf-8</charset>--></encoder></appender><logger name="com.hcxz.baseframework" level="debug"/><logger name="com.hithium" level="debug"/><!--Record to File Hour, Record Two class One class is error Log, One is All Log--><root level="info"><appender-ref ref="STDOUT"/><appender-ref ref="FILE_ERROR"/><appender-ref ref="FILE_INFO"/></root></springProfile></configuration>