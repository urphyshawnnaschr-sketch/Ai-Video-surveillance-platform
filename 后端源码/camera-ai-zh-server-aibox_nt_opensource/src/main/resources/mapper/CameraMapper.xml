<?xml version="1.0" encoding="UTF-8" ?><!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd" ><mapper namespace="com.yihecode.camera.ai.mapper.CameraMapper"><select id="defaultPage" resultType="com.yihecode.camera.ai.entity.Camera"><choose><!--when not has Refer Fixed cameraIds Hour, Optimize First Query Fixed Fixed ID--><when test="cameraDto.idList == null or cameraDto.idList.size() == 0">(SELECT id, name FROM tbl_biz_camera WHERE id IN<foreach collection="cameraDto.defaultIdList" item="id" open="(" separator="," close=")">#{id}</foreach>AND state = 0<if test="cameraDto.running!= null and cameraDto.running == 1">AND running = #{cameraDto.running}</if><if test="cameraDto.locationIdList!= null and cameraDto.locationIdList.size() > 0">AND location_id IN<foreach collection="cameraDto.locationIdList" item="locId" open="(" separator="," close=")">#{locId}</foreach></if>) UNION ALL (SELECT id, name FROM tbl_biz_camera WHERE id NOT IN<foreach collection="cameraDto.defaultIdList" item="id" open="(" separator="," close=")">#{id}</foreach>AND state = 0<if test="cameraDto.running!= null and cameraDto.running == 1">AND running = #{cameraDto.running}</if><if test="cameraDto.locationIdList!= null and cameraDto.locationIdList.size() > 0">AND location_id IN<foreach collection="cameraDto.locationIdList" item="locId" open="(" separator="," close=")">#{locId}</foreach></if>)</when><!--when Refer Fixed cameraIds Hour, by Normal Query--><otherwise>SELECT id, name FROM tbl_biz_camera WHERE state = 0<if test="cameraDto.running!= null and cameraDto.running == 1">AND running = #{cameraDto.running}</if><if test="cameraDto.locationIdList!= null and cameraDto.locationIdList.size() > 0">AND location_id IN<foreach collection="cameraDto.locationIdList" item="locId" open="(" separator="," close=")">#{locId}</foreach></if>AND id IN<foreach collection="cameraDto.idList" item="camId" open="(" separator="," close=")">#{camId}</foreach></otherwise></choose></select></mapper>