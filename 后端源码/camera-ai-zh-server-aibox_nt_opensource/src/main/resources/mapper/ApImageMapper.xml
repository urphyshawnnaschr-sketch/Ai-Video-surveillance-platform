        "http://mybatis.org/dtd/mybatis-3-mapper.dtd"><mapper namespace="com.yihecode.camera.ai.mapper.ap.ApImageMapper"><resultMap id="resultMap" type="com.yihecode.camera.ai.entity.ap.Image"><id column="id" property="id" /><result column="created_at" property="createdAt" /><result column="updated_at" property="updatedAt" /><result column="project_id" property="projectId" /><result column="data_file_id" property="dataFileId" /><result column="storage_path" property="storagePath" /><result column="width" property="width" /><result column="height" property="height" /><result column="depth" property="depth" /><result column="md5" property="md5" /><result column="status" property="status" /><result column="need_review" property="needReview" /><result column="label_user_id" property="labelUserId" /><result column="review_user_id" property="reviewUserId" /><result column="assigned_at" property="assignedAt" /><result column="expired_at" property="expiredAt" /><result column="commit_id" property="commitId" /></resultMap><select id="selectWithLabel" resultMap="resultMap">select i.* from<include refid="searchCondition"/>group by i.id order by i.id limit ${(page - 1) * limit}, #{limit}</select><select id="countWithLabel" resultType="java.lang.Long">select count(distinct i.id) from<include refid="searchCondition"/></select><sql id="searchCondition">ap_images i<if test = "label!=null and label!=''">left join ap_annotation a on a.project_id = i.project_id and a.image_id = i.id and a.commit_id = i.commit_id and a.deleted_at is null</if>where i.project_id = #{projectId} and i.deleted_at is null<if test = "labelUserId!=null and labelUserId!=0">and i.label_user_id = #{labelUserId}</if><if test = "reviewUserId!=null and reviewUserId!=0">and i.review_user_id = #{reviewUserId}</if><if test = "labelStatus!=null and labelStatus==1">and i.status in (0,1,6)</if><if test = "labelStatus!=null and labelStatus==2">and i.status in (4)</if><if test = "labelStatus!=null and labelStatus==3">and i.status in (5,11,15,16)</if><if test = "reviewStatus!=null and reviewStatus==1">and i.status in (5) and i.need_review = 1</if><if test = "reviewStatus!=null and reviewStatus==2">and i.status in (11) and i.need_review = 1</if><if test = "reviewStatus!=null and reviewStatus==3">and i.status in (15) and i.need_review = 1</if><if test = "reviewStatus!=null and reviewStatus==4">and i.status in (16) and i.need_review = 1</if><if test = "reviewStatus!=null and reviewStatus==8">and i.status in (15,16) and i.need_review = 1</if><if test = "label!=null and label!=''">and a.tag_name = #{label}</if></sql></mapper>